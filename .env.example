# AQUA-SHIELD runs fully offline. No API keys are required for inference.
# These are optional operational overrides only.
AQS_DEVICE=auto            # auto | mps | cpu
AQS_MODEL_PATH=models/aquashield_primary.pt
AQS_DB_PATH=outputs/aquashield.db
AQS_OFFLINE_MAP=1          # 1 = do not fetch remote map tiles
